DATABASE_URL=postgresql+psycopg2://postgres:your-password@localhost:5432/repair_shop
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-secret

# --- Object storage for order photos (S3-compatible: AWS S3, Cloudflare R2, MinIO) ---
# If S3_ACCESS_KEY/S3_SECRET_KEY/S3_BUCKET are set, photos upload to object storage.
# Otherwise photos fall back to a local disk folder (backend/uploads/).
#S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
#S3_REGION=us-east-1
#S3_ACCESS_KEY=your-access-key
#S3_SECRET_KEY=your-secret-key
#S3_BUCKET=your-bucket
#STORAGE_PUBLIC_BASE=https://pub-<hash>.r2.dev
